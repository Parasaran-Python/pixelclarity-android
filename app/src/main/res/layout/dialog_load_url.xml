<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_url_description"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilImageUrl"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_image_url"
        app:startIconDrawable="@drawable/ic_link"
        app:startIconTint="@color/accent_glow"
        app:endIconMode="clear_text"
        app:endIconTint="@color/on_surface_variant"
        app:boxStrokeColor="@color/accent_glow"
        app:boxBackgroundColor="@color/surface"
        app:hintTextColor="@color/accent_glow"
        android:textColorHint="@color/on_surface_variant"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etImageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quick Sample URL Chips -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quick_samples_title"
        android:textColor="@color/accent_glow"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupSamples"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleLine="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSamplePhoto"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chip_sample_photo"
            android:textColor="@color/on_surface"
            app:chipBackgroundColor="@color/surface_variant"
            app:chipStrokeColor="@color/divider"
            app:chipStrokeWidth="1dp"
            app:chipIcon="@drawable/ic_sparkle"
            app:chipIconTint="@color/accent_glow" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSampleAnime"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chip_sample_anime"
            android:textColor="@color/on_surface"
            app:chipBackgroundColor="@color/surface_variant"
            app:chipStrokeColor="@color/divider"
            app:chipStrokeWidth="1dp"
            app:chipIcon="@drawable/ic_sparkle"
            app:chipIconTint="@color/secondary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPasteClipboard"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chip_paste_clipboard"
            android:textColor="@color/on_surface"
            app:chipBackgroundColor="@color/surface_variant"
            app:chipStrokeColor="@color/divider"
            app:chipStrokeWidth="1dp"
            app:chipIcon="@drawable/ic_link"
            app:chipIconTint="@color/accent_glow" />
    </com.google.android.material.chip.ChipGroup>

</LinearLayout>
