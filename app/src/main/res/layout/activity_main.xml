<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- App Title Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/on_background"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_tagline"
                        android:textColor="@color/accent_glow"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoadUrlTop"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_link"
                    app:iconTint="@color/accent_glow"
                    android:contentDescription="@string/desc_load_url" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAboutCredits"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_info"
                    app:iconTint="@color/on_surface_variant"
                    android:contentDescription="@string/desc_about_credits" />
            </LinearLayout>

            <!-- Image Preview Box / Before-After Slider -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="340dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/surface_variant"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Interactive Slider View -->
                    <com.pv.realesrgan.ui.BeforeAfterSliderView
                        android:id="@+id/sliderView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- Inspect Fullscreen Overlay Button -->
                    <!-- Inspect Fullscreen Overlay Button -->
                    <FrameLayout
                        android:id="@+id/btnInspectFullscreen"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_circle_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        android:contentDescription="@string/desc_inspect_fullscreen">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_fullscreen"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <!-- Empty State Placeholder -->
                    <LinearLayout
                        android:id="@+id/emptyStateView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_image_placeholder"
                            android:importantForAccessibility="no"
                            app:tint="@color/on_surface_variant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/empty_state_title"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/empty_state_description"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp"
                            android:textAlignment="center"
                            android:layout_marginTop="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginTop="16dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPickImageEmpty"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:minWidth="220dp"
                                android:text="@string/pick_image"
                                app:icon="@drawable/ic_photo_library"
                                app:iconGravity="textStart"
                                app:cornerRadius="12dp"
                                app:backgroundTint="@color/primary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLoadUrlEmpty"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:minWidth="220dp"
                                android:text="@string/load_url"
                                app:icon="@drawable/ic_link"
                                app:iconGravity="textStart"
                                app:iconTint="@color/accent_glow"
                                android:textColor="@color/on_surface"
                                app:strokeColor="@color/surface_variant"
                                app:strokeWidth="1dp"
                                app:cornerRadius="12dp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Image Resolution Specs Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResolutionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/surface_variant"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvResolutionInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Input: 512x512"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resolution_arrow"
                        android:textColor="@color/accent_glow"
                        android:textSize="14sp"
                        android:layout_marginHorizontal="8dp" />

                    <TextView
                        android:id="@+id/tvResolutionOutput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Output: 2048x2048"
                        android:textColor="@color/accent_glow"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/surface_variant"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Model Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/model_title"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipModelX4Plus"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/model_real_esrgan_x4plus" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipModelAnime6B"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/model_anime_6b" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Output Scale -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scale_title"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupScale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipScale4x"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/scale_4x" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipScale2x"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/scale_2x" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipScaleCustom"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_tune"
                            app:chipIconTint="@color/accent_glow"
                            android:text="@string/scale_custom" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Expandable Custom Scale Controls -->
                    <LinearLayout
                        android:id="@+id/layoutCustomScale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_custom_scale_card"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/custom_scale_multiplier_title"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCustomScaleValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scale_preset_3_0x"
                                android:textColor="@color/accent_glow"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderCustomScale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="1.0"
                            android:valueTo="8.0"
                            android:stepSize="0.5"
                            android:value="3.0"
                            app:thumbColor="@color/accent_glow"
                            app:trackColorActive="@color/primary"
                            app:trackColorInactive="@color/surface_variant" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupCustomPresets"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPreset15x"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scale_preset_1_5x"
                                android:textColor="@color/on_surface"
                                app:chipBackgroundColor="@color/surface_variant"
                                app:chipStrokeColor="@color/divider" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPreset3x"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scale_preset_3_0x"
                                android:textColor="@color/on_surface"
                                app:chipBackgroundColor="@color/surface_variant"
                                app:chipStrokeColor="@color/divider" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPreset5x"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scale_preset_5_0x"
                                android:textColor="@color/on_surface"
                                app:chipBackgroundColor="@color/surface_variant"
                                app:chipStrokeColor="@color/divider" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPreset8x"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scale_preset_8_0x"
                                android:textColor="@color/on_surface"
                                app:chipBackgroundColor="@color/surface_variant"
                                app:chipStrokeColor="@color/divider" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>

                    <!-- Hardware Delegate -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hardware_title"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupHardware"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipHwAuto"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/hw_auto" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipHwNpu"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hw_npu" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipHwCpu"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hw_cpu" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Tile Size -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tile_title"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupTileSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTile256"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/tile_256" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTile128"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tile_128" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progress Indicator & Status View -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/surface_variant"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_ready"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        app:indicatorColor="@color/accent_glow"
                        app:trackColor="@color/surface_variant"
                        app:trackCornerRadius="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangeImage"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="@string/change_image"
                        app:cornerRadius="12dp"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpscale"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1.2"
                        android:text="@string/upscale_action"
                        app:icon="@drawable/ic_sparkle"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancel"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:text="@string/cancel_action"
                        android:textColor="@color/error"
                        app:strokeColor="@color/error"
                        app:cornerRadius="12dp"
                        android:visibility="gone"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Save & Share & Inspect Buttons (Displayed after completion) -->
                <LinearLayout
                    android:id="@+id/layoutSaveShare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="12dp">

                    <!-- Row 1: Save + Share -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSave"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="@string/save_action"
                            app:icon="@drawable/ic_save"
                            app:iconGravity="textStart"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/secondary"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShare"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="@string/share_action"
                            app:icon="@drawable/ic_share"
                            app:iconGravity="textStart"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <!-- Row 2: Inspect & Zoom spanning full width -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInspect"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/inspect_action"
                        app:icon="@drawable/ic_fullscreen"
                        app:iconGravity="textStart"
                        app:iconTint="@color/accent_glow"
                        android:textColor="@color/accent_glow"
                        app:strokeColor="@color/accent_glow"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
